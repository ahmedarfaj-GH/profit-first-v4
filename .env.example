# Copy this file to .env and fill in real values. Never commit .env.
# In production these are set in the hosting dashboard instead (see DEPLOY.md).

# development | production (production enforces strict config and hides /docs)
APP_ENV=development

# Leave empty locally to use a SQLite file. In production use a PostgreSQL URL, e.g.
# postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=

# Programmatic API access (header: X-API-Key)
API_KEY=changeme-generate-a-long-random-string

# Signs the web UI session cookie
SESSION_SECRET=changeme-generate-a-long-random-string

# Web UI login. Generate the three secrets above/below with:  python scripts/generate_secrets.py
UI_LOGIN_USER=admin
UI_LOGIN_PASSWORD_HASH=$2b$12$replace-with-a-real-bcrypt-hash
